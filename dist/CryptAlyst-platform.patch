+    const k=classify(t);
+    const c=k==="LEAKED"?"#d29922":k==="BAD_ENTRY"?"#f85149":k==="FEE"?"#58a6ff":"#3fb950";
+    const r=Math.max(3,Math.min(9,Math.sqrt((t.notional||1000)/900)));
+    g+=`<circle cx="${X(Math.max(0.02,t.peak_pct||0)).toFixed(1)}" cy="${Y(t.net_pct||0).toFixed(1)}"
