+function ema(vals,p){
+  var k=2/(p+1), e=vals[0], out=[e];
+  for(var i=1;i<vals.length;i++){ e=vals[i]*k+e*(1-k); out.push(e); }
+  return out;
+}
+function boll(vals,p,m){
+  var mid=[],up=[],dn=[];
+  for(var i=0;i<vals.length;i++){
+    if(i<p-1){ mid.push(null); up.push(null); dn.push(null); continue; }
+    var w=vals.slice(i-p+1,i+1), s=0;
+    for(var j=0;j<w.length;j++) s+=w[j];
+    var mm=s/p, sd=0;
+    for(var k=0;k<w.length;k++) sd+=(w[k]-mm)*(w[k]-mm);
+    sd=Math.sqrt(sd/p);
+    mid.push(mm); up.push(mm+m*sd); dn.push(mm-m*sd);
+  }
+  return {mid:mid,up:up,dn:dn};
+}
