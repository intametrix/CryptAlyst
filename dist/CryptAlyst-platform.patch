+  var vs=Math.max(0,Math.min(n-vc,S.s||0));
+  S.c=vc; S.s=vs;
+  var win=BARS.slice(vs,vs+vc);
+
+  var lo=Math.min.apply(null,win.map(function(b){return b.l;}));
+  var hi=Math.max.apply(null,win.map(function(b){return b.h;}));
+  var LO,HI;
+  if(S.y){
+    var ylo=Math.min(S.y.lo,S.y.hi), yhi=Math.max(S.y.lo,S.y.hi);
+    var minSpan=Math.max(1e-9,(hi-lo)*0.002), maxSpan=(hi-lo)*40;
+    if(!isFinite(ylo)||!isFinite(yhi)||yhi-ylo<=0){ S.y=null; }
+    else if(yhi-ylo<minSpan){ var mid=(ylo+yhi)/2; S.y={lo:mid-minSpan/2,hi:mid+minSpan/2}; }
+    else if(yhi-ylo>maxSpan){ var mid2=(ylo+yhi)/2; S.y={lo:mid2-maxSpan/2,hi:mid2+maxSpan/2}; }
+    if(S.y){ LO=S.y.lo; HI=S.y.hi; S.scaleMode="manual"; }
+    else { var pad0=(hi-lo)*0.08||1; LO=lo-pad0; HI=hi+pad0; S.scaleMode="auto"; }
+  }
+  if(!S.y){
+    var pad=(hi-lo)*0.08||1;
+    LO=lo-pad; HI=hi+pad; S.scaleMode="auto";
+    if(OV.atr){
+      var atr0=atrSeries(), m=0;
+      for(var q=vs;q<vs+vc;q++) if(atr0[q]>m) m=atr0[q];
+      if(m){ LO-=m; HI+=m; }
+    }
+  }
+  var y=function(v){ return PT+(H-PT-PB)*(1-(v-LO)/(HI-LO)); };
+  var x=function(i){ return PL+(W-PL-PR)*((i-vs)/Math.max(1,vc-1)); };
+  var bw=Math.max(1.5,(W-PL-PR)/vc*0.6);
+  var maxV=Math.max.apply(null,win.map(function(b){return b.v;}))||1;
+  var yv=function(v){ return H-12-((H-PT-PB)*0.16)*(v/maxV); };
+
+  var s="";
+  var TICKS=5;
+  AX.tPrice=0; AX.tTime=0;
+  for(var g=0;g<=TICKS;g++){
+    var gv=LO+(HI-LO)*g/TICKS, gy=y(gv).toFixed(1);
+    if(P.priceAxis) AX.tPrice++;
+    if(P.grid) s+='<line x1="'+PL+'" y1="'+gy+'" x2="'+(W-PR)+'" y2="'+gy+'" stroke="#18222d"/>';
+    if(P.priceAxis) s+='<text x="'+(PL-7)+'" y="'+(y(gv)+3.5).toFixed(1)+'" fill="#4a5866" font-size="10" text-anchor="end" font-family="monospace">'+fmt(gv)+'</text>';
+    if(P.dualAxis&&win.length){
+      var base0=win[0].c;
+      var pctv=((gv/base0)-1)*100;
+      var pcol=pctv>=0?"#3fb95099":"#f8514999";
+      s+='<text x="'+(W-PR+8)+'" y="'+(y(gv)+3.5).toFixed(1)+'" fill="'+pcol+'" font-size="9.5" font-family="monospace">'+
+         (pctv>=0?"+":"")+pctv.toFixed(1)+'%</text>';
+    } else if(P.priceAxisRight){
+      s+='<text x="'+(W-PR+8)+'" y="'+(y(gv)+3.5).toFixed(1)+'" fill="#3f4c5c" font-size="9.5" font-family="monospace">'+fmt(gv)+'</text>';
+    }
+  }
+
+  if(P.dualAxis){
+    s+='<text x="'+(PL-7)+'" y="'+(PT+2)+'" fill="#3f4c5c" font-size="8.5" text-anchor="end" font-family="monospace">PRICE</text>';
+    s+='<text x="'+(W-PR+8)+'" y="'+(PT+2)+'" fill="#3f4c5c" font-size="8.5" font-family="monospace">CHG %</text>';
+  }
+  if(P.timeAxis){
+    var stepT=Math.max(1,Math.floor(vc/5));
+    for(var it=vs;it<vs+vc;it+=stepT){
+      var bb=BARS[it]; if(!bb) continue;
+      var d0=new Date(bb.t);
