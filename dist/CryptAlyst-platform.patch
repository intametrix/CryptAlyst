+  }
+
+  if(OV.vol&&P.volumePane) win.forEach(function(b,k){
+    var i=vs+k, up=b.c>=b.o;
+    s+='<rect x="'+(x(i)-bw/2).toFixed(1)+'" y="'+yv(b.v).toFixed(1)+'" width="'+bw.toFixed(1)+
