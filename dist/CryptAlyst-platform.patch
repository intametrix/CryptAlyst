+
+  var SER = (S.chart==="heikin") ? heikin(BARS).slice(vs,vs+vc) : win;
+  if(S.chart==="line"||S.chart==="area"){
+    var lp="", lst=false;
+    for(var li=0;li<SER.length;li++){
+      lp+=(lst?"L":"M")+x(vs+li).toFixed(1)+","+y(SER[li].c).toFixed(1)+" "; lst=true;
+    }
+    if(S.chart==="area"&&lp){
+      s+='<linearGradient id="ag" x1="0" y1="0" x2="0" y2="1">'+
