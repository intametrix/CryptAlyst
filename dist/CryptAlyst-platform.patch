+<!doctype html>
+<html><head><meta charset="utf-8"><title>chart control test</title>
+<style>
+ body{margin:0;background:#0b0f14;color:#e6edf6;font:13px -apple-system,BlinkMacSystemFont,ui-monospace,monospace}
