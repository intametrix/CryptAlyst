+      s+='<path d="'+lp+'L'+x(vs+SER.length-1).toFixed(1)+','+(H-PB)+' L'+x(vs).toFixed(1)+','+(H-PB)+' Z" fill="url(#ag)"/>';
+    }
+    s+='<path d="'+lp+'" fill="none" stroke="#58a6ff" stroke-width="1.6"/>';
+  } else {
+    SER.forEach(function(b,k){
+      var i=vs+k, up=b.c>=b.o, col=up?"#3fb950":"#f85149";
