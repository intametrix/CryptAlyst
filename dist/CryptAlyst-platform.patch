+ .chips{display:flex;flex-wrap:wrap;gap:6px}
+ .info{padding:6px 2px;font-size:11px;color:#5b6b7d}
+</style></head><body>
+
+<header>
+  <h1>chart control test</h1>
+  <span id="sym" style="font-weight:700;color:#58a6ff">SIM/USD</span>
+  <span id="px" style="font-size:16px">—</span>
+  <span id="chg" style="font-size:12px">—</span>
+  <span class="sp"></span>
+  <button id="btn" onclick="toggle()">⚙ control</button>
+</header>
+
+<div class="wrap">
+  <div id="panel">
+    <div class="row"><span class="lab">timeframe</span><div class="chips" id="iv"></div></div>
+    <div class="row"><span class="lab">layers</span><div class="chips" id="ly"></div></div>
+    <div class="row"><span class="lab">view</span><div class="chips" id="vw"></div></div>
+    <div class="info" id="sub"></div>
+  </div>
+  <div class="card">
+    <svg id="svg" viewBox="0 0 1100 420" preserveAspectRatio="none"></svg>
+    <div class="info">drag = zoom box · drag the price scale = zoom price · drag the time scale = zoom time · shift-drag = pan · wheel = zoom time · shift+wheel = zoom price · double-click = full zoom out</div>
+  </div>
+</div>
+
+<script>
+var W=1100,H=420,PL=56,PR=70,PT=10,PB=76;
+var OV={vol:true,ema:true,band:false,mark:true};
+var S={tf:"5m",s:0,c:null,y:null,measure:false};
+var BARS=[],MEAS=null,BAND=null,G={n:0,x:0,y:0,s:0,c:0,d:0,pinch:0,mode:null},GEO=null;
+
+/* ---------- synthetic data (no network) ---------- */
+function makeBars(tf){
+  var n=240, step={ "1m":60000,"5m":300000,"15m":900000,"1h":3600000 }[tf]||300000;
+  var px=100, seed=tf.length*7919, out=[], t=Date.now()-n*step;
+  for(var i=0;i<n;i++){
+    seed=(seed*9301+49297)%233280;
+    var rnd=seed/233280;
+    var drift=(rnd-0.48)*0.9;
+    var o=px;
+    var c=o+drift;
+    var h=Math.max(o,c)+rnd*0.5;
+    var l=Math.min(o,c)-rnd*0.5;
+    var v=800+rnd*2200;
+    out.push({t:t+i*step,o:o,h:h,l:l,c:c,v:v});
+    px=c;
+  }
+  return out;
+}
+
+function ema(vals,p){
+  var k=2/(p+1), e=vals[0], out=[e];
+  for(var i=1;i<vals.length;i++){ e=vals[i]*k+e*(1-k); out.push(e); }
+  return out;
+}
+
+function $(id){ return document.getElementById(id); }
+
+function draw(){
+  if(!BARS.length) return;
+  var n=BARS.length;
+  var vc=Math.max(15,Math.min(n,S.c||n));
+  var vs=Math.max(0,Math.min(n-vc,S.s||0));
+  S.c=vc; S.s=vs;
+  var win=BARS.slice(vs,vs+vc);
+  var lo=Math.min.apply(null,win.map(function(b){return b.l;}));
+  var hi=Math.max.apply(null,win.map(function(b){return b.h;}));
+  var LO,HI;
+  if(S.y){ LO=S.y.lo; HI=S.y.hi; }
+  else { var p=(hi-lo)*0.08||1; LO=lo-p; HI=hi+p; }
+
+  var y=function(v){ return PT+(H-PT-PB)*(1-(v-LO)/(HI-LO)); };
+  var x=function(i){ return PL+(W-PL-PR)*((i-vs)/Math.max(1,vc-1)); };
+  var bw=Math.max(1.5,(W-PL-PR)/vc*0.6);
+  var maxV=Math.max.apply(null,win.map(function(b){return b.v;}));
+  var yv=function(v){ return H-12-((H-PT-PB)*0.16)*(v/maxV); };
+
+  var s='';
+
+  for(var g=0;g<=4;g++){
+    var gv=LO+(HI-LO)*g/4;
+    s+='<line x1="'+PL+'" y1="'+y(gv).toFixed(1)+'" x2="'+(W-PR)+'" y2="'+y(gv).toFixed(1)+'" stroke="#18222d"/>';
+    s+='<text x="'+(PL-7)+'" y="'+(y(gv)+3.5).toFixed(1)+'" fill="#4a5866" font-size="10" text-anchor="end" font-family="monospace">'+gv.toFixed(2)+'</text>';
+  }
+
+  if(OV.vol) win.forEach(function(b,k){
+    var i=vs+k, up=b.c>=b.o;
+    s+='<rect x="'+(x(i)-bw/2).toFixed(1)+'" y="'+yv(b.v).toFixed(1)+'" width="'+bw.toFixed(1)+'" height="'+Math.max(0.5,H-12-yv(b.v)).toFixed(1)+'" fill="'+(up?"#2ea043":"#da3633")+'" opacity=".25"/>';
+  });
+
+  win.forEach(function(b,k){
+    var i=vs+k, up=b.c>=b.o, col=up?"#3fb950":"#f85149";
+    s+='<line x1="'+x(i).toFixed(1)+'" y1="'+y(b.h).toFixed(1)+'" x2="'+x(i).toFixed(1)+'" y2="'+y(b.l).toFixed(1)+'" stroke="'+col+'"/>';
+    var y1=y(Math.max(b.o,b.c)), y2=y(Math.min(b.o,b.c));
+    s+='<rect x="'+(x(i)-bw/2).toFixed(1)+'" y="'+y1.toFixed(1)+'" width="'+bw.toFixed(1)+'" height="'+Math.max(1,y2-y1).toFixed(1)+'" fill="'+col+'" opacity=".9"/>';
+  });
+
+  if(OV.ema){
+    var e20=ema(BARS.map(function(b){return b.c;}),20);
+    var e50=ema(BARS.map(function(b){return b.c;}),50);
+    [[e20,"#58a6ff"],[e50,"#d29922"]].forEach(function(pair){
+      var pth="", st=false;
+      for(var i=Math.max(0,vs-1);i<vs+vc;i++){ pth+=(st?"L":"M")+x(i).toFixed(1)+","+y(pair[0][i]).toFixed(1)+" "; st=true; }
+      s+='<path d="'+pth+'" fill="none" stroke="'+pair[1]+'" stroke-width="1.4" opacity=".9"/>';
+    });
+  }
+
+  if(OV.band){
+    var pv=0, vv=0;
+    var cum=BARS.map(function(b){ var tp=(b.h+b.l+b.c)/3; pv+=tp*b.v; vv+=b.v; return pv/vv; });
+    var p2="", st2=false;
+    for(var i2=Math.max(0,vs-1);i2<vs+vc;i2++){ p2+=(st2?"L":"M")+x(i2).toFixed(1)+","+y(cum[i2]).toFixed(1)+" "; st2=true; }
+    s+='<path d="'+p2+'" fill="none" stroke="#e3b341" stroke-width="1.5" opacity=".9"/>';
+  }
+
+  if(OV.mark){
+    var marks=[{i:Math.floor(vc*0.35),p:win[Math.floor(vc*0.35)].l,side:"buy"},
+               {i:Math.floor(vc*0.62),p:win[Math.floor(vc*0.62)].h,side:"sell"}];
+    marks.forEach(function(m){
+      var i=vs+m.i, up=m.side==="buy";
+      s+='<path d="M'+x(i).toFixed(1)+','+(y(m.p)+(up?10:-10)).toFixed(1)+' l6,10 l-12,0 z" transform="rotate('+(up?0:180)+' '+x(i).toFixed(1)+' '+y(m.p).toFixed(1)+')" fill="'+(up?"#3fb950":"#f85149")+'"/>';
+      s+='<text x="'+x(i).toFixed(1)+'" y="'+(y(m.p)+(up?26:-16)).toFixed(1)+'" fill="#8494a8" font-size="9" text-anchor="middle" font-family="monospace">'+(up?"BUY":"SELL")+'</text>';
+    });
+  }
+
+  var last=BARS[BARS.length-1];
+  s+='<line x1="'+PL+'" y1="'+y(last.c).toFixed(1)+'" x2="'+(W-PR)+'" y2="'+y(last.c).toFixed(1)+'" stroke="#58a6ff" stroke-dasharray="5 4" opacity=".6"/>';
+  s+='<rect x="'+(W-PR+3)+'" y="'+(y(last.c)-9).toFixed(1)+'" width="64" height="18" rx="4" fill="#17293a" stroke="#2f4a66"/>';
+  s+='<text x="'+(W-PR+35)+'" y="'+(y(last.c)+4).toFixed(1)+'" fill="#9ecbff" font-size="10" text-anchor="middle" font-family="monospace">'+last.c.toFixed(2)+'</text>';
+
+  if(MEAS){
+    var a=Math.min(MEAS.i0,MEAS.i1), b=Math.max(MEAS.i0,MEAS.i1);
+    var x0=x(Math.max(vs,Math.min(vs+vc-1,a))), x1=x(Math.max(vs,Math.min(vs+vc-1,b)));
+    var p0=y(MEAS.p0), p1=y(MEAS.p1);
+    var dp=MEAS.p1-MEAS.p0, dpp=100*(MEAS.p1/MEAS.p0-1), bars=Math.abs(b-a);
+    var col=dp>=0?"#3fb950":"#f85149";
+    s+='<rect x="'+Math.min(x0,x1).toFixed(1)+'" y="'+Math.min(p0,p1).toFixed(1)+'" width="'+Math.abs(x1-x0).toFixed(1)+'" height="'+Math.abs(p1-p0).toFixed(1)+'" fill="'+col+'1f" stroke="'+col+'" stroke-dasharray="4 3"/>';
+    var bx=Math.min(x0,x1)+8, by=Math.min(p0,p1)+8;
+    s+='<rect x="'+bx.toFixed(1)+'" y="'+by.toFixed(1)+'" width="150" height="48" rx="7" fill="#0a1219f2" stroke="'+col+'88"/>';
+    s+='<text x="'+(bx+12).toFixed(1)+'" y="'+(by+20).toFixed(1)+'" fill="'+col+'" font-size="12" font-family="monospace">'+(dp>=0?"+":"")+dpp.toFixed(2)+'%</text>';
+    s+='<text x="'+(bx+12).toFixed(1)+'" y="'+(by+36).toFixed(1)+'" fill="#8494a8" font-size="10" font-family="monospace">'+bars+' bars</text>';
+  }
+
+  s+='<g id="xh" opacity="0"></g>';
+  $("svg").innerHTML=s;
+  $("px").textContent=last.c.toFixed(2);
+  var chg=100*(last.c/BARS[0].o-1);
+  $("chg").textContent=(chg>=0?"+":"")+chg.toFixed(2)+"%";
+  $("chg").style.color=chg>=0?"#3fb950":"#f85149";
+  $("sub").textContent=S.tf+" · "+vc+"/"+n+" bars · "+Object.keys(OV).filter(function(k){return OV[k];}).length+"/"+Object.keys(OV).length+" layers";
+  GEO={vs:vs,vc:vc,LO:LO,HI:HI};
+}
+
+/* ---------- interaction ---------- */
+function pt(ev){
+  var r=$("svg").getBoundingClientRect();
+  return {x:(ev.clientX-r.left)/r.width*W, y:(ev.clientY-r.top)/r.height*H};
+}
+function vx(ev){ return pt(ev).x; }
+function zoomX(px,count){
+  var n=BARS.length, nc=Math.max(15,Math.min(n,Math.round(count)));
+  var f=Math.max(0,Math.min(1,(px-PL)/(W-PL-PR)));
+  var a=(S.s||0)+f*((S.c||n)-1);
+  S.c=nc; S.s=Math.max(0,Math.min(n-nc,a-f*(nc-1)));
+  draw();
+}
+function zoomY(py,factor){
+  if(!GEO) return;
+  var f=Math.max(0,Math.min(1,(py-PT)/(H-PT-PB)));
+  var at=GEO.HI-(GEO.HI-GEO.LO)*f;
+  var span=(GEO.HI-GEO.LO)*factor;
+  S.y={lo:at-span*(1-f),hi:at+span*f};
+  draw();
+}
+function reset(){ S.s=0; S.c=null; S.y=null; MEAS=null; draw(); }
+
+function cross(ev){
+  var g=document.getElementById("xh"); if(!g||!GEO) return;
+  var p=pt(ev);
+  if(p.x<PL||p.x>W-PR||p.y<PT||p.y>H-PB){ g.setAttribute("opacity","0"); return; }
+  var i=Math.max(GEO.vs,Math.min(GEO.vs+GEO.vc-1,GEO.vs+Math.round((p.x-PL)/(W-PL-PR)*(GEO.vc-1))));
+  var b=BARS[i]; if(!b) return;
+  var price=GEO.LO+(GEO.HI-GEO.LO)*(1-(p.y-PT)/(H-PT-PB));
+  g.setAttribute("opacity","1");
+  g.innerHTML='<line x1="'+p.x.toFixed(1)+'" y1="'+PT+'" x2="'+p.x.toFixed(1)+'" y2="'+(H-PB)+'" stroke="#41566b" stroke-dasharray="3 3"/>'+
+    '<line x1="'+PL+'" y1="'+p.y.toFixed(1)+'" x2="'+(W-PR)+'" y2="'+p.y.toFixed(1)+'" stroke="#41566b" stroke-dasharray="3 3"/>'+
+    '<rect x="'+(W-PR+3)+'" y="'+(p.y-9).toFixed(1)+'" width="64" height="18" rx="4" fill="#17293a" stroke="#2f4a66"/>'+
+    '<text x="'+(W-PR+35)+'" y="'+(p.y+4).toFixed(1)+'" fill="#9ecbff" font-size="10" text-anchor="middle" font-family="monospace">'+price.toFixed(2)+'</text>'+
+    '<rect x="'+(p.x>W/2?PL+6:W-PR-180).toFixed(1)+'" y="'+(PT+6)+'" width="174" height="46" rx="7" fill="#0a1219f0" stroke="#24313e"/>'+
+    '<text x="'+(p.x>W/2?PL+16:W-PR-170).toFixed(1)+'" y="'+(PT+22).toFixed(1)+'" fill="#e6edf6" font-size="10" font-family="monospace">O '+b.o.toFixed(2)+'  H '+b.h.toFixed(2)+'</text>'+
+    '<text x="'+(p.x>W/2?PL+16:W-PR-170).toFixed(1)+'" y="'+(PT+38).toFixed(1)+'" fill="#e6edf6" font-size="10" font-family="monospace">L '+b.l.toFixed(2)+'  C '+b.c.toFixed(2)+'</text>';
+}
+
+function bandStart(ev){
+  var svg=$("svg");
+  var g=svg.querySelector("#sel");
+  if(!g){ g=document.createElementNS("http://www.w3.org/2000/svg","g"); g.id="sel"; svg.appendChild(g); }
+  var p=pt(ev);
+  BAND={x0:p.x,y0:p.y,x1:p.x,y1:p.y};
+  g.setAttribute("opacity","1");
+  g.innerHTML='<rect id="sr" x="'+p.x+'" y="'+p.y+'" width="0" height="0" fill="#58a6ff1f" stroke="#58a6ff" stroke-dasharray="3 3"/>';
+}
+function bandMove(ev){
+  var g=document.querySelector("#sel"); if(!g||!BAND) return;
+  var p=pt(ev); BAND.x1=p.x; BAND.y1=p.y;
+  var r=g.querySelector("#sr"); if(!r) return;
+  r.setAttribute("x",Math.min(BAND.x0,BAND.x1).toFixed(1));
+  r.setAttribute("y",Math.min(BAND.y0,BAND.y1).toFixed(1));
+  r.setAttribute("width",Math.abs(BAND.x1-BAND.x0).toFixed(1));
+  r.setAttribute("height",Math.abs(BAND.y1-BAND.y0).toFixed(1));
+}
+function bandClear(){ var g=document.querySelector("#sel"); if(g){ g.innerHTML=""; g.setAttribute("opacity","0"); } BAND=null; }
+function bandEnd(){
+  if(!BAND||!GEO){ bandClear(); return; }
+  var b=BAND;
+  var w=Math.abs(b.x1-b.x0), h=Math.abs(b.y1-b.y0);
+  var p0=GEO.LO+(GEO.HI-GEO.LO)*(1-(b.y0-PT)/(H-PT-PB));
+  var p1=GEO.LO+(GEO.HI-GEO.LO)*(1-(b.y1-PT)/(H-PT-PB));
+  var i0=Math.round(GEO.vs+(b.x0-PL)/(W-PL-PR)*(GEO.vc-1));
+  var i1=Math.round(GEO.vs+(b.x1-PL)/(W-PL-PR)*(GEO.vc-1));
+  bandClear();
+  if(w<8&&h<8) return;
+  if(S.measure){ MEAS={i0:i0,i1:i1,p0:p0,p1:p1}; draw(); return; }
+  if(h>=8) S.y={lo:Math.min(p0,p1),hi:Math.max(p0,p1)};
+  if(w>=8){
+    var nc=Math.max(15,Math.min(BARS.length,Math.abs(i1-i0)+1));
+    S.c=nc; S.s=Math.max(0,Math.min(BARS.length-nc,Math.min(i0,i1)));
+  }
+  draw();
+}
+
+function region(ev){
+  var p=pt(ev);
+  if(p.x>W-PR) return "axisY";     // price scale
+  if(p.y>H-PB) return "axisX";     // time scale
+  if(p.x<PL) return "axisY";
+  return "plot";
+}
+
+function wire(){
+  var svg=$("svg");
+  svg.addEventListener("pointerdown",function(e){
+    var reg=region(e);
+    svg.setPointerCapture(e.pointerId);
+    G.n++; G.px=e.clientX; G.py=e.clientY; G.s0=S.s; G.c0=S.c||BARS.length;
+    if(reg==="axisY"){
+      G.mode="axisY";
+      var lo=S.y?S.y.lo:null, hi=S.y?S.y.hi:null;
+      if(lo==null||hi==null){ lo=GEO?GEO.LO:0; hi=GEO?GEO.HI:1; }
+      G.ay={lo:lo,hi:hi,cy:(lo+hi)/2,span:hi-lo};
+      svg.style.cursor="ns-resize";
+      return;
+    }
+    if(reg==="axisX"){
+      G.mode="axisX";
+      G.ax={c0:S.c||BARS.length};
+      svg.style.cursor="ew-resize";
+      return;
+    }
+    G.mode=e.shiftKey?"pan":"select";
+    if(G.mode==="select") bandStart(e);
+  });
+  svg.addEventListener("pointerdown",function(e){
+    var r=svg.getBoundingClientRect();
+    G.dist=0;
+  });
+  svg.addEventListener("pointermove",function(e){
+    if(G.n===0){
+      cross(e);
+      var r=region(e);
+      svg.style.cursor = r==="axisY"?"ns-resize":(r==="axisX"?"ew-resize":"crosshair");
+    }
+    if(G.mode==="axisY"&&G.ay){
+      var dy=e.clientY-G.py;
+      var f=Math.exp(dy*0.006);              // drag down = zoom out
+      var span=Math.max(G.ay.span*0.02,Math.min(G.ay.span*50,G.ay.span*f));
+      S.y={lo:G.ay.cy-span/2, hi:G.ay.cy+span/2};
+      draw();
+      return;
+    }
+    if(G.mode==="axisX"&&G.ax){
+      var dx=e.clientX-G.px;
+      var g=Math.exp(-dx*0.006);             // drag right = zoom in
+      var nc=Math.max(15,Math.min(BARS.length,G.ax.c0*g));
+      zoomX((PL+W-PR)/2,nc);
+      return;
+    }
+    if(G.mode==="select"){ bandMove(e); return; }
+    if(G.mode==="pan"){
+      var dx=e.clientX-G.px, per=W-PL-PR, nc=S.c||BARS.length;
+      var ns=Math.max(0,Math.min(BARS.length-nc,G.s0+Math.round(-dx/per*nc)));
+      if(ns!==S.s){ S.s=ns; draw(); }
+    }
+  });
+  svg.addEventListener("pointerup",function(e){
+    if(G.mode==="select") bandEnd();
+    if(G.mode==="axisY"||G.mode==="axisX"){ svg.style.cursor="crosshair"; }
+    G.n=Math.max(0,G.n-1); G.mode=null; G.ay=null; G.ax=null;
+  });
+  svg.addEventListener("pointerleave",function(){
+    G.n=0; G.mode=null;
+    var g=document.getElementById("xh"); if(g) g.setAttribute("opacity","0");
+  });
+  svg.addEventListener("wheel",function(e){
+    e.preventDefault();
+    if(e.shiftKey){ zoomY(pt(e).y,e.deltaY>0?1.1:0.91); return; }
+    zoomX(vx(e),(S.c||BARS.length)*(e.deltaY>0?1.12:0.89));
+  },{passive:false});
+  svg.addEventListener("dblclick",function(e){ e.preventDefault(); reset(); });
+  document.addEventListener("keydown",function(e){
+    if(e.key==="Escape"){ MEAS=null; closePanel(); draw(); }
+  });
+}
+function dist2(a,b){ return Math.hypot(a.x-b.x,a.y-b.y); }
+
+/* ---------- control ---------- */
+function chips(){
+  $("iv").innerHTML=["1m","5m","15m","1h"].map(function(t){
+    return '<button class="'+(t===S.tf?"on":"")+'" onclick="setTf(\''+t+'\')">'+t+'</button>';
+  }).join("");
+  var labels={vol:"volume",ema:"EMA 20/50",band:"VWAP",mark:"trade marks"};
+  $("ly").innerHTML=Object.keys(OV).map(function(k){
+    return '<button class="'+(OV[k]?"on":"")+'" onclick="toggleLayer(\''+k+'\')">'+labels[k]+'</button>';
+  }).join("");
+  $("vw").innerHTML=
+    '<button class="'+(S.measure?"armed":"")+'" onclick="toggleMeasure()">measure'+(S.measure?" ✕":"")+'</button>'+
+    '<button onclick="zoomX((PL+W-PR)/2,(S.c||BARS.length)*0.7)">zoom in</button>'+
+    '<button onclick="zoomX((PL+W-PR)/2,(S.c||BARS.length)*1.4)">zoom out</button>'+
+    '<button onclick="S.y=null;draw()">reset price</button>'+
+    '<button onclick="reset()">reset all</button>';
+  $("sub").textContent=S.tf+" · "+Object.keys(OV).filter(function(k){return OV[k];}).length+"/"+Object.keys(OV).length+" layers"+(S.measure?" · measure armed":"");
+}
+function setTf(tf){ S.tf=tf; BARS=makeBars(tf); S.c=null; S.s=0; S.y=null; MEAS=null; chips(); draw(); }
+function toggleLayer(k){ OV[k]=!OV[k]; chips(); draw(); }
+function toggleMeasure(){ S.measure=!S.measure; MEAS=null; chips(); draw(); }
+function toggle(){
+  var p=$("panel");
+  p.classList.toggle("open");
+  $("btn").textContent=p.classList.contains("open")?"✕ close":"⚙ control";
+  if(p.classList.contains("open")) chips();
+}
+function closePanel(){ $("panel").classList.remove("open"); $("btn").textContent="⚙ control"; }
+
+BARS=makeBars(S.tf);
+wire(); chips(); draw();
+</script></body></html>
