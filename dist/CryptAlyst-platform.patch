+    if(ty+th>H-PB) ty=H-PB-th-6;
+    if(ty<PT) ty=PT+4;
+    var tip='<g opacity=".98"><rect x="'+tx.toFixed(1)+'" y="'+ty.toFixed(1)+'" width="'+tw+'" height="'+th+
+            '" rx="7" fill="#0a1219f5" stroke="#2a3a4a"/>'+
+            '<text x="'+(tx+9).toFixed(1)+'" y="'+(ty+14).toFixed(1)+'" fill="#8494a8" font-size="9.5" font-family="monospace">'+when+'</text>';
+    rows.forEach(function(r,ri){
+      var yy=ty+27+ri*13;
+      var col=(r[0]==="chg")?(dchg>=0?"#3fb950":"#f85149"):"#e6edf6";
+      tip+='<text x="'+(tx+9).toFixed(1)+'" y="'+yy.toFixed(1)+'" fill="#5b6b7d" font-size="9.5" font-family="monospace">'+r[0]+'</text>'+
+           '<text x="'+(tx+tw-9).toFixed(1)+'" y="'+yy.toFixed(1)+'" fill="'+col+'" font-size="9.5" text-anchor="end" font-family="monospace">'+r[1]+'</text>';
+    });
+    tip+='</g>';
+    g.innerHTML+=tip;
+  }
+  if($("props")) props();
+}
+
+function bandStart(ev){
+  var svg=$("svg"), g=svg.querySelector("#sel");
+  if(!g){ g=document.createElementNS("http://www.w3.org/2000/svg","g"); g.id="sel"; svg.appendChild(g); }
+  var p=pt(ev);
+  BAND={x0:p.x,y0:p.y,x1:p.x,y1:p.y};
+  g.setAttribute("opacity","1");
+  g.innerHTML='<rect id="sr" x="'+p.x+'" y="'+p.y+'" width="0" height="0" fill="#58a6ff1f" stroke="#58a6ff" stroke-dasharray="3 3"/>';
+}
+function bandMove(ev){
+  var g=document.querySelector("#sel"); if(!g||!BAND) return;
+  var p=pt(ev); BAND.x1=p.x; BAND.y1=p.y;
+  var r=g.querySelector("#sr"); if(!r) return;
+  r.setAttribute("x",Math.min(BAND.x0,BAND.x1).toFixed(1));
+  r.setAttribute("y",Math.min(BAND.y0,BAND.y1).toFixed(1));
+  r.setAttribute("width",Math.abs(BAND.x1-BAND.x0).toFixed(1));
+  r.setAttribute("height",Math.abs(BAND.y1-BAND.y0).toFixed(1));
+}
+function bandClear(){
+  var g=document.querySelector("#sel");
+  if(g){ g.innerHTML=""; g.setAttribute("opacity","0"); }
+  BAND=null;
+}
+function bandEnd(){
+  if(!BAND||!GEO){ bandClear(); return; }
+  var b=BAND, w=Math.abs(b.x1-b.x0), h=Math.abs(b.y1-b.y0);
+  var p0=GEO.LO+(GEO.HI-GEO.LO)*(1-(b.y0-PT)/(H-PT-PB));
+  var p1=GEO.LO+(GEO.HI-GEO.LO)*(1-(b.y1-PT)/(H-PT-PB));
+  var i0=Math.round(GEO.vs+(b.x0-PL)/(W-PL-PR)*(GEO.vc-1));
+  var i1=Math.round(GEO.vs+(b.x1-PL)/(W-PL-PR)*(GEO.vc-1));
+  bandClear();
+  if(w<8&&h<8) return;
+  if(S.measure){ MEAS={i0:i0,i1:i1,p0:p0,p1:p1}; draw(); return; }
+  if(h>=8) S.y={lo:Math.min(p0,p1),hi:Math.max(p0,p1)};
+  if(w>=8){
+    var nc=Math.max(15,Math.min(BARS.length,Math.abs(i1-i0)+1));
+    S.c=nc; S.s=Math.max(0,Math.min(BARS.length-nc,Math.min(i0,i1)));
+  }
+  draw();
+}
+
+function wire(){
+  var svg=$("svg");
+  svg.addEventListener("pointerdown",function(e){
+    var reg=region(e);
+    svg.setPointerCapture(e.pointerId);
+    if(e.isPrimary){
+      Array.from(G.pts.keys()).forEach(function(id){ if(id!==e.pointerId) G.pts.delete(id); });
+      G.pinch=null;
+    }
+    G.pts.set(e.pointerId,{x:e.clientX,y:e.clientY});
+    if(G.pts.size===2){
+      var pp=Array.from(G.pts.values());
+      G.mode="pinch";
+      bandClear();
+      G.pinch={
+        dx:Math.abs(pp[0].x-pp[1].x), dy:Math.abs(pp[0].y-pp[1].y),
+        cx:(pp[0].x+pp[1].x)/2, cy:(pp[0].y+pp[1].y)/2,
+        c0:S.c||BARS.length, lo:S.y?S.y.lo:(GEO?GEO.LO:0), hi:S.y?S.y.hi:(GEO?GEO.HI:1)
+      };
+      return;
+    }
+    G.px=e.clientX; G.py=e.clientY; G.s0=S.s; G.c0=S.c||BARS.length;
+    if(reg==="axisY"){
+      G.mode="axisY";
+      var lo=S.y?S.y.lo:(GEO?GEO.LO:0), hi=S.y?S.y.hi:(GEO?GEO.HI:1);
+      G.ay={cy:(lo+hi)/2,span:(hi-lo)};
+      svg.style.cursor="ns-resize"; return;
+    }
+    if(reg==="axisX"){ G.mode="axisX"; G.ax={c0:S.c||BARS.length}; svg.style.cursor="ew-resize"; return; }
+    if(e.altKey){
+      G.mode="axisY";
+      var lo2=S.y?S.y.lo:(GEO?GEO.LO:0), hi2=S.y?S.y.hi:(GEO?GEO.HI:1);
+      G.ay={cy:(lo2+hi2)/2,span:(hi2-lo2)};
+      svg.style.cursor="ns-resize"; return;
+    }
+    var wantBox = (S.tool==="box") || e.shiftKey;
+    G.mode = wantBox ? "select" : "pan";
+    if(G.mode==="select") bandStart(e);
+  });
+  svg.addEventListener("pointermove",function(e){
+    if(G.pts.has(e.pointerId)) G.pts.set(e.pointerId,{x:e.clientX,y:e.clientY});
+    if(G.mode==="pinch"&&G.pinch&&G.pts.size>=2){
+      var pp=Array.from(G.pts.values());
+      var dx=Math.abs(pp[0].x-pp[1].x), dy=Math.abs(pp[0].y-pp[1].y);
+      var cx=(pp[0].x+pp[1].x)/2, cy=(pp[0].y+pp[1].y)/2;
+      var fx=G.pinch.dx>4?G.pinch.dx/Math.max(4,dx):1;
+      var fy=G.pinch.dy>4?G.pinch.dy/Math.max(4,dy):1;
+      var horiz=fx!==1, vert=fy!==1;
+      if(horiz&&vert){
+        // diagonal pinch: pick the dominant axis so it does not fight itself
+        if(Math.abs(Math.log(fx))>=Math.abs(Math.log(fy))) vert=false; else horiz=false;
+      }
+      if(horiz){
+        var r0=svg.getBoundingClientRect();
+        var vx=(cx-r0.left)/r0.width*W;
+        var nc=Math.max(15,Math.min(BARS.length,(G.c0)*fx));
+        var f=Math.max(0,Math.min(1,(vx-PL)/(W-PL-PR)));
+        var a=(S.s||0)+f*((S.c||BARS.length)-1);
+        S.c=Math.round(nc);
+        S.s=Math.max(0,Math.min(BARS.length-S.c,a-f*(S.c-1)));
+      }
+      if(vert){
+        var r1=svg.getBoundingClientRect();
+        var vy=(cy-r1.top)/r1.height*H;
+        var cy0=G.pinch.cy;
+        var pm=f=>0;
+        var span=(G.pinch.hi-G.pinch.lo);
+        var midp=(G.pinch.lo+G.pinch.hi)/2;
+        var nspan=Math.max(span*0.02,Math.min(span*50,span*fy));
+        S.y={lo:midp-nspan/2, hi:midp+nspan/2};
+      }
+      draw();
+      return;
+    }
+    if(!G.mode){
+      cross(e);
+      var r=region(e);
+      svg.style.cursor=r==="axisY"?"ns-resize":(r==="axisX"?"ew-resize":"crosshair");
+      return;
+    }
+    if(G.mode==="axisY"&&G.ay){
+      var f=Math.exp((e.clientY-G.py)*0.006);
+      var span=Math.max(G.ay.span*0.02,Math.min(G.ay.span*50,G.ay.span*f));
+      S.y={lo:G.ay.cy-span/2,hi:G.ay.cy+span/2};
+      draw(); return;
+    }
+    if(G.mode==="axisX"&&G.ax){
+      var g=Math.exp(-(e.clientX-G.px)*0.006);
+      zoomX((PL+W-PR)/2,G.ax.c0*g); return;
+    }
+    if(G.mode==="select"){ bandMove(e); return; }
+    if(G.mode==="pan"){
+      var dx=e.clientX-G.px, per=W-PL-PR, nc=S.c||BARS.length;
+      var ns=Math.max(0,Math.min(BARS.length-nc,G.s0+Math.round(-dx/per*nc)));
+      if(ns!==S.s){ S.s=ns; draw(); }
+    }
+  });
+  function end(e){
+    if(e&&e.pointerId!=null) G.pts.delete(e.pointerId);
+    // finish whatever gesture was running BEFORE clearing the mode
+    var was=G.mode;
+    if(was==="select") bandEnd();
+    if(was==="axisY"||was==="axisX") $("svg").style.cursor="crosshair";
+    if(G.pts.size<2) G.pinch=null;
+    if(G.pts.size===0){ G.mode=null; G.ay=null; G.ax=null; }
+  }
+  svg.addEventListener("pointerup",end);
+  svg.addEventListener("pointercancel",end);
+  svg.addEventListener("pointerleave",function(e){
+    if((G.mode==="axisY"||G.mode==="axisX")){ end(e); }
+    if(G.mode==="select" && (e.buttons===0)){ end(e); }
+    var g=document.getElementById("xh"); if(g) g.setAttribute("opacity","0");
+    CURSOR=null;
+  });
+  window.addEventListener("pointerup",function(e){ if(G.pts.size) end(e); });
+  window.addEventListener("blur",function(){ G.pts.clear(); G.mode=null; G.pinch=null; });
+  svg.addEventListener("wheel",function(e){
+    e.preventDefault();
+    var p=pt(e);
+    var r=svg.getBoundingClientRect();
+    var vx=(e.clientX-r.left)/r.width*W;
+
+    // trackpad pinch arrives as ctrl+wheel -> zoom BOTH axes together
+    if(e.ctrlKey||e.metaKey){
+      var f=Math.exp(e.deltaY*0.012);
+      var nc=Math.max(15,Math.min(BARS.length,(S.c||BARS.length)*f));
+      var frac=Math.max(0,Math.min(1,(vx-PL)/(W-PL-PR)));
+      var a=(S.s||0)+frac*((S.c||BARS.length)-1);
+      S.c=Math.round(nc);
+      S.s=Math.max(0,Math.min(BARS.length-S.c,a-frac*(S.c-1)));
+      zoomY(p.y,f);
+      return;
+    }
+    // shift or option + scroll -> price only (the trackpad-friendly vertical route)
+    if(e.shiftKey||e.altKey){ zoomY(p.y,e.deltaY>0?1.1:0.91); return; }
+
+    var vc0=S.c||BARS.length;
+    // plain scroll -> PAN (no zoom): horizontal moves time, vertical moves price
+    if(P.scrollPan){
+      var moved=false;
+
+      // --- horizontal: shift the bar window ---
+      var perBar=(W-PL-PR)/Math.max(1,vc0-1);
+      var bars=Math.round((e.deltaX||0)/perBar);
+      if(bars!==0){
+        var ns=Math.max(0,Math.min(BARS.length-vc0,(S.s||0)+bars));
+        if(ns!==S.s){ S.s=ns; moved=true; }
+      }
+
+      // --- vertical: slide the price range ---
+      if(e.deltaY){
+        var span=(GEO?GEO.HI-GEO.LO:1)||1;
+        var plotH=Math.max(40,H-PT-PB);
+        var shift=-span*(e.deltaY/plotH);     // reversed: drag down lowers the range
+        var baseLo=S.y?S.y.lo:(GEO?GEO.LO:0);
+        var baseHi=S.y?S.y.hi:(GEO?GEO.HI:1);
+        S.y={lo:baseLo+shift, hi:baseHi+shift};
+        moved=true;
+      }
+
+      if(moved) draw();
+      return;
+    }
+    zoomX(vx,vc0*(e.deltaY>0?1.12:0.89));
+  },{passive:false});
+  svg.addEventListener("dblclick",function(e){ e.preventDefault(); reset(); });
+  document.addEventListener("keydown",function(e){
+    if(e.key==="Escape"){ MEAS=null; closePanel(); draw(); return; }
+    if(BARS.length<2||!GEO) return;
+    var cx=(PL+W-PR)/2, cy=(PT+H-PB)/2, n=S.c||BARS.length;
+    if(e.key==="+"||e.key==="="){
+      e.preventDefault();
+      if(e.shiftKey) zoomY(cy,0.9); else zoomX(cx,n*0.8);
+    } else if(e.key==="-"||e.key==="_"){
+      e.preventDefault();
+      if(e.shiftKey) zoomY(cy,1.1); else zoomX(cx,n*1.25);
+    } else if(e.key==="ArrowLeft"){
+      e.preventDefault(); S.s=Math.max(0,(S.s||0)-Math.round(n*0.2)); draw();
+    } else if(e.key==="ArrowRight"){
+      e.preventDefault(); S.s=Math.min(BARS.length-n,(S.s||0)+Math.round(n*0.2)); draw();
+    } else if(e.key==="0"){
+      e.preventDefault(); reset();
+    }
+  });
+}
+
+function chips(){
+  $("iv").innerHTML=["1m","5m","15m","1h"].map(function(t){
+    return '<button class="'+(t===S.tf?"on":"")+'" onclick="setTf(\''+t+'\')">'+t+'</button>';
+  }).join("");
+  $("ct").innerHTML=CHART_META.map(function(m){
+    return '<button class="'+(S.chart===m.id?"on":"")+'" onclick="setChart(\''+m.id+'\')">'+m.label+'</button>';
+  }).join("");
+  $("ly").innerHTML=LAYER_META.map(function(m){
+    return '<button class="'+(OV[m.id]?"on":"")+'" onclick="toggleLayer(\''+m.id+'\')">'+m.label+'</button>';
+  }).join("");
+  $("sc").innerHTML=
+    '<button class="'+(S.log?"":"on")+'" onclick="setLog(false)">linear</button>'+
+    '<button class="'+(S.log?"on":"")+'" onclick="setLog(true)">log</button>'+
+    '<button class="'+(S.y?"":"on")+'" onclick="S.y=null;chips();draw()">auto price</button>'+
+    '<button class="'+(S.y?"on":"")+'" onclick="lockPrice()">manual price</button>';
+  $("pr").innerHTML=PROP_META.map(function(m){
+    return '<button class="'+(P[m.id]?"on":"")+'" onclick="toggleProp(\''+m.id+'\')">'+m.label+'</button>';
+  }).join("");
+  $("vw").innerHTML=
+    '<button class="'+(S.tool==="pan"?"on":"")+'" onclick="setTool(\'pan\')">pan</button>'+
+    '<button class="'+(S.tool==="box"?"on":"")+'" onclick="setTool(\'box\')">zoom box</button>'+
+    '<button class="'+(S.measure?"armed":"")+'" onclick="toggleMeasure()">measure'+(S.measure?" ✕":"")+'</button>'+
+    '<button onclick="zoomX((PL+W-PR)/2,(S.c||BARS.length)*0.7)">zoom in</button>'+
+    '<button onclick="zoomX((PL+W-PR)/2,(S.c||BARS.length)*1.4)">zoom out</button>'+
+    '<button onclick="reset()">reset all</button>';
+  $("sub").textContent=S.tf+" · "+LAYER_META.filter(function(m){return OV[m.id];}).length+"/"+LAYER_META.length+
+    " overlays · "+PROP_META.filter(function(m){return P[m.id];}).length+"/"+PROP_META.length+
+    " properties"+(S.measure?" · measure armed":"")+(S.log?" · log scale":"");
+}
+function setChart(c){ S.chart=c; chips(); draw(); }
+function setTool(t){ S.tool=t; chips(); }
+function toggleProp(k){ P[k]=!P[k]; chips(); draw(); }
+function setTf(tf){ S.tf=tf; BARS=makeBars(tf); S.c=null; S.s=0; S.y=null; MEAS=null; chips(); draw(); }
+function toggleLayer(id){ OV[id]=!OV[id]; chips(); draw(); }
+function toggleMeasure(){ S.measure=!S.measure; MEAS=null; chips(); draw(); }
+function setLog(on){ S.log=on; chips(); draw(); }
+function lockPrice(){ if(GEO) S.y={lo:GEO.LO,hi:GEO.HI}; chips(); draw(); }
+function toggle(){
+  var p=$("panel");
+  p.classList.toggle("open");
+  $("btn").textContent=p.classList.contains("open")?"✕ close":"⚙ control";
+  if(p.classList.contains("open")) chips();
+}
+function closePanel(){ $("panel").classList.remove("open"); $("btn").textContent="⚙ control"; }
+
+function fit(){
+  var svg=$("svg");
+  var r=svg.getBoundingClientRect();
+  var w=Math.max(420,Math.round(r.width));
+  var h=Math.max(240,Math.round(r.height));
+  // axis bands keep a constant pixel size as the chart grows
+  PB=Math.round(Math.min(110,Math.max(52,h*0.16)));
+  PR=Math.round(Math.min(110,Math.max(56,w*0.065)));
+  PL=Math.round(Math.min(90,Math.max(46,w*0.05)));
+  // keep a usable plot area; the axis bands must never eat the whole canvas
+  if(W-PL-PR<220){ PR=Math.max(50,Math.min(PR,W-PL-220)); }
+  if(H-PT-PB<140){ PB=Math.max(44,Math.min(PB,H-PT-140)); }
+  if(Math.abs(w-W)>2||Math.abs(h-H)>2){
+    W=w; H=h;
+    svg.setAttribute("viewBox","0 0 "+W+" "+H);
+  }
+  return {w:w,h:h};
+}
+function refit(){ fit(); draw(); props(); }
+
+BARS=makeBars(S.tf);
+wire(); chips(); fit(); draw();
+window.addEventListener("resize",function(){ refit(); });
+if(window.ResizeObserver){
+  new ResizeObserver(function(){ refit(); }).observe($("svg").parentElement);
+}
+</script></body></html>
