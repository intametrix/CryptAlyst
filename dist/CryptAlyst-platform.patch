+    return '<button class="'+(S.chart===m.id?"on":"")+'" onclick="setChart(\''+m.id+'\')">'+m.label+'</button>';
+  }).join("");
+  $("ly").innerHTML=LAYER_META.map(function(m){
+    return '<button class="'+(OV[m.id]?"on":"")+'" onclick="toggleLayer(\''+m.id+'\')">'+m.label+'</button>';
+  }).join("");
+  $("sc").innerHTML=
+    '<button class="'+(S.log?"":"on")+'" onclick="setLog(false)">linear</button>'+
+    '<button class="'+(S.log?"on":"")+'" onclick="setLog(true)">log</button>'+
+    '<button class="'+(S.y?"":"on")+'" onclick="S.y=null;chips();draw()">auto price</button>'+
+    '<button class="'+(S.y?"on":"")+'" onclick="lockPrice()">manual price</button>';
+  $("pr").innerHTML=PROP_META.map(function(m){
+    return '<button class="'+(P[m.id]?"on":"")+'" onclick="toggleProp(\''+m.id+'\')">'+m.label+'</button>';
+  }).join("");
+  $("vw").innerHTML=
+    '<button class="'+(LIVE?"on":"")+'" onclick="setLive('+(!LIVE)+')">'+(LIVE?"live ●":"paused")+'</button>'+
+    '<button class="'+(S.tool==="pan"?"on":"")+'" onclick="setTool(\'pan\')">pan</button>'+
+    '<button class="'+(S.tool==="box"?"on":"")+'" onclick="setTool(\'box\')">zoom box</button>'+
+    '<button class="'+(S.measure?"armed":"")+'" onclick="toggleMeasure()">measure'+(S.measure?" ✕":"")+'</button>'+
+    '<button onclick="zoomX((PL+W-PR)/2,(S.c||BARS.length)*0.7)">zoom in</button>'+
+    '<button onclick="zoomX((PL+W-PR)/2,(S.c||BARS.length)*1.4)">zoom out</button>'+
+    '<button onclick="reset()">reset all</button>';
+  $("sub").textContent=S.tf+" · "+LAYER_META.filter(function(m){return OV[m.id];}).length+"/"+LAYER_META.length+
+    " overlays · "+PROP_META.filter(function(m){return P[m.id];}).length+"/"+PROP_META.length+
+    " properties"+(S.measure?" · measure armed":"")+(S.log?" · log scale":"");
+}
+function engineScope(){
+  var el=$("enginescope");
+  if(!el) return;
+  if(ENGINE){
+    el.style.display="inline-flex";
+    el.textContent="scope: "+ENGINE+" ✕";
+  } else { el.style.display="none"; }
+}
+function clearEngine(){
+  ENGINE=null; engineScope();
+  loadFills(function(){ draw(); });
+}
+function setSym(v){
+  if(!v) return;
+  SYM=v; $("symlabel").textContent=v; FILLS=[];
+  loadBars(S.tf, function(){ loadFills(function(){ draw(); }); });
+}
+function setChart(c){ S.chart=c; chips(); draw(); }
+function setTool(t){ S.tool=t; chips(); }
+function toggleProp(k){ P[k]=!P[k]; chips(); draw(); }
+function setTf(tf){ S.tf=tf; chips(); loadBars(tf,function(){ draw(); }); }
+function toggleLayer(id){ OV[id]=!OV[id]; chips(); draw(); }
+function toggleMeasure(){ S.measure=!S.measure; MEAS=null; chips(); draw(); }
+function setLog(on){ S.log=on; chips(); draw(); }
+function lockPrice(){ if(GEO) S.y={lo:GEO.LO,hi:GEO.HI}; chips(); draw(); }
+function toggle(){
+  var p=$("panel");
+  p.classList.toggle("open");
+  $("btn").textContent=p.classList.contains("open")?"✕ close":"⚙ control";
+  if(p.classList.contains("open")) chips();
+}
+function closePanel(){ $("panel").classList.remove("open"); $("btn").textContent="⚙ control"; }
+
+function fit(){
+  var svg=$("svg");
+  var r=svg.getBoundingClientRect();
+  var w=Math.max(420,Math.round(r.width));
+  var h=Math.max(240,Math.round(r.height));
+  // axis bands keep a constant pixel size as the chart grows
+  PB=Math.round(Math.min(110,Math.max(52,h*0.16)));
+  PR=Math.round(Math.min(110,Math.max(56,w*0.065)));
+  PL=Math.round(Math.min(90,Math.max(46,w*0.05)));
+  // keep a usable plot area; the axis bands must never eat the whole canvas
+  if(W-PL-PR<220){ PR=Math.max(50,Math.min(PR,W-PL-220)); }
+  if(H-PT-PB<140){ PB=Math.max(44,Math.min(PB,H-PT-140)); }
+  if(Math.abs(w-W)>2||Math.abs(h-H)>2){
+    W=w; H=h;
+    svg.setAttribute("viewBox","0 0 "+W+" "+H);
+  }
+  return {w:w,h:h};
+}
+function refit(){ fit(); draw(); props(); }
+
+($("sym")||{}).value=SYM;
+$("symlabel").textContent=SYM;
+engineScope();
+wire(); chips(); fit();
+loadBars(S.tf, function(){
+  loadSignals(function(){ loadFills(function(){ draw(); }); });
+});
+setInterval(pollLive, LIVE_MS);
+setInterval(function(){ loadSignals(function(){ loadFills(function(){ draw(); }); }); }, 15000);
+window.addEventListener("resize",function(){ refit(); });
+if(window.ResizeObserver){
+  new ResizeObserver(function(){ refit(); }).observe($("svg").parentElement);
+}
+</script></body></html>
