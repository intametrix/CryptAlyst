+function heikin(src){
+  var out=[], prevO=src[0].o, prevC=src[0].c;
+  for(var i=0;i<src.length;i++){
+    var b=src[i];
+    var c=(b.o+b.h+b.l+b.c)/4;
+    var o=(i===0)?(b.o+b.c)/2:(prevO+prevC)/2;
+    var h=Math.max(b.h,o,c), l=Math.min(b.l,o,c);
+    out.push({t:b.t,o:o,h:h,l:l,c:c,v:b.v});
+    prevO=o; prevC=c;
+  }
+  return out;
+}
+
+function atrSeries(){
+  var out=[], prev=0;
+  for(var i=0;i<BARS.length;i++){
+    if(i===0){ out.push(0); continue; }
+    var b=BARS[i], p=BARS[i-1];
+    var tr=Math.max(b.h-b.l, Math.abs(b.h-p.c), Math.abs(b.l-p.c));
+    prev=(i===1)?tr:(prev*13+tr)/14;
+    out.push(prev);
+  }
+  return out;
+}
+function rsiSeries(){
+  var out=[], g=0, l=0;
+  for(var i=0;i<BARS.length;i++){
+    if(i===0){ out.push(null); continue; }
+    var d=BARS[i].c-BARS[i-1].c;
+    g=(g*13+Math.max(d,0))/14; l=(l*13+Math.max(-d,0))/14;
+    out.push(l===0?100:100-100/(1+g/l));
+  }
+  return out;
+}
