flowchart LR
  CAP["<b>capabilities</b><br/>derived from the topic registry<br/>topic · producer · max_age_ms"]:::c_control
  J["<b>journal</b><br/>newest packet per topic+key<br/>generation · computed_at"]:::c_store
  CAP --> P{"plan"}
  J --> P
  P -->|"within its deadline"| S["serve<br/><i>the answer is current</i>"]
  P -->|"older than its deadline"| R["recompute"]
  P -->|"nothing recorded"| R
  R --> W["control.engine packet<br/>a request for work — an envelope,<br/>so it is recorded and replayable"]:::c_model
  class S c_intel;
