flowchart LR
    S1["signal t0"] --> W["intel window<br/>[ts, ts, ts]"]
    S2["signal t1"] --> W
    S3["signal t2"] --> W
    W --> P{"≥ N agreeing<br/>in window?"}
    P -- yes --> T["tier signal<br/>(confirmed)"]
    P -- no --> S1
    class S1,S2,S3 c_intel
