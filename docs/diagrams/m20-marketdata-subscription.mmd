flowchart LR
    W["wss://stream.binance.com:9443"] -->|"subscribe 90 symbols"| S["combined stream"]
    S --> F["frame dispatch<br/>stream name → handler"]
    F --> D["depth handler"]
    F --> K["kline handler"]
    D --> IMB["imbalance cache"]
    K --> KL["candle cache"]
    IMB & KL --> PUB["publish on bus"]
    class W c_market
    class S,F c_neutral
    class D,K c_intel
    class IMB,KL c_store
    class PUB c_market
