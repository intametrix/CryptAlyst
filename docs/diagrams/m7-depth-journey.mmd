flowchart LR
    B["order book<br/>depth5@100ms"] --> I["imbalance = (bid−ask)/(bid+ask)"]
    I --> P["market.depth<br/>{symbol, imbalance, bids, asks}"]
    P --> BUS["BUS"]
    BUS --> R["recorder → lake"]
    BUS --> CR["curve_rider<br/>reads strongest imbalance"]
