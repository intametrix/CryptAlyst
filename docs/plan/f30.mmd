flowchart TD
  L1["live: market.candle packets"] --> L2["live: operators, models + detectors"]
  L2 --> L3["live: intel.forecast and alerts"]
  L3 --> L4["journal"]
  L4 --> B1["replay: journal window + config version"]
  B1 --> B2["replay: same operators, same binaries"]
  B2 --> B3["replay: graded outcomes, identical math to live"]

