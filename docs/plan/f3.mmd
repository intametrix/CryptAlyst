flowchart TB
  subgraph SRC["sources"]
    BN["Binance REST + WebSocket"]
    IMP["operator imports, evidence"]
  end
  subgraph ING["ingest"]
    NORM["normalizers: bars, trades, books"]
  end
  subgraph STORE["storage"]
    HIST["history store: candles per symbol+interval"]
    JR["envelope journal: append-only, replayable"]
  end
  subgraph BUS["the envelope pipeline"]
    PIPE["authority - keying - correlation - freshness"]
  end
  subgraph COMPUTE["compute"]
    LAB["forecast lab: 40+ models, graded"]
    DET["detectors: flow onset, breakout, reversal"]
    ENG["execution engine - Phase 6"]
    GPUX["GPU agent: sweep, optimize, timestral"]
  end
  subgraph SERVE["serve"]
    API["JSON API, one mux"]
    WEB["React dashboard"]
    EXPX["envelope explorer :8802"]
  end
  OP["the operator: approves phases and rungs"]
  BN --> NORM --> HIST
  IMP --> JR
  HIST --> PIPE
  PIPE --> LAB
  PIPE --> DET
  LAB --> JR
  DET --> JR
  LAB --> API
  DET --> API
  ENG --> JR
  GPUX <--> PIPE
  API --> WEB
  JR --> EXPX
  WEB --> OP
