flowchart TD
  UNI["all listed symbols"]
  FLO["liquidity floors"]
  CAP["cap and depth tiers"]
  T1["tier-1: kline z-composite, every tick"]
  TH{"above theta?"}
  MON["stay monitored"]
  T2["tier-2: temporary book subscription"]
  AL["onset alert"]
  UNI --> FLO --> CAP --> T1 --> TH
  TH -->|no| MON
  TH -->|yes| T2 --> AL
classDef proc fill:#d8eef2,stroke:#0f6b7a,color:#08343c,stroke-width:2px;
classDef data fill:#e9e3f7,stroke:#5b3fa8,color:#2a1a55,stroke-width:2px;
classDef decision fill:#ffe9c7,stroke:#b7791f,color:#4a2f00,stroke-width:2px;
classDef ok fill:#d9f2e3,stroke:#1d7a4d,color:#0d3b26,stroke-width:2px;
classDef ext fill:#dbe9fb,stroke:#1d4e89,color:#0b2545,stroke-width:2px;
classDef hot fill:#ffe9c7,stroke:#b7791f,color:#4a2f00,stroke-width:2px;
class MON data;
class TH decision;
class UNI ext;
class T2 hot;
class AL ok;
class FLO,CAP,T1 proc;
