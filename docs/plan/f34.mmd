flowchart TD
  OPT["GPU optimizer<br/>seeded search, MAE objective"] --> T["tuned_symbol candidate<br/>registry row, versioned params"]
  LAB["walk-forward lab<br/>out-of-sample windows"] --> GATE{"beats best by<br/>pre-registered margin?"}
  T --> GATE
  GATE -->|no| HOLD["stays candidate<br/>visible in lab, never auto-selected"]
  GATE -->|yes| REC["recommendation<br/>envelope on model.decision"]
  REC --> HUMAN{"human approves?<br/>Rule A6: durable, audited"}
  HUMAN -->|yes| LIVE["selected via saved path<br/>monitored by M1 coverage + skill"]
  HUMAN -->|no| HOLD
  LIVE -->|skill decays / coverage breach| DEMOTE["auto-demote to best<br/>post-mortem written"]

classDef proc fill:#d8eef2,stroke:#0f6b7a,color:#08343c,stroke-width:2px;
classDef data fill:#e9e3f7,stroke:#5b3fa8,color:#2a1a55,stroke-width:2px;
classDef decision fill:#ffe9c7,stroke:#b7791f,color:#4a2f00,stroke-width:2px;
classDef ok fill:#d9f2e3,stroke:#1d7a4d,color:#0d3b26,stroke-width:2px;
classDef err fill:#fbdcdc,stroke:#a4232b,color:#4a0f13,stroke-width:2px;
classDef ext fill:#dbe9fb,stroke:#1d4e89,color:#0b2545,stroke-width:2px;
classDef hot fill:#ffe9c7,stroke:#b7791f,color:#4a2f00,stroke-width:2px;
classDef human fill:#eef1f5,stroke:#4b5b6e,color:#1f2b38,stroke-width:2px;

class LAB,HOLD proc;
class T data;
class GATE decision;
class REC,LIVE ok;
class DEMOTE err;
class OPT hot;
class HUMAN human;
