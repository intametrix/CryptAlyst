flowchart TD
  INTENT["order intent<br/>from decision engine"] --> G{"risk gateway"}
  subgraph G[" "]
    direction TB
    L1["per-order limits<br/>max notional, price band:<br/>refuse outside conformal p10-p90"]
    L2["position limits<br/>max per symbol, max heat (open risk sum)"]
    L3["rate limits<br/>max orders/min, max cancels/min"]
    L4["regime gates<br/>no new entries if band width above theta<br/>or freshness refusal active"]
    L5["kill switch state<br/>HALTED refuses everything"]
  end
  G -->|pass| ADAPTER["exchange adapter"]
  G -->|refuse| ERR["system.error envelope<br/>rule, values, intent — auditable"]

classDef proc fill:#d8eef2,stroke:#0f6b7a,color:#08343c,stroke-width:2px;
classDef data fill:#e9e3f7,stroke:#5b3fa8,color:#2a1a55,stroke-width:2px;
classDef decision fill:#ffe9c7,stroke:#b7791f,color:#4a2f00,stroke-width:2px;
classDef ok fill:#d9f2e3,stroke:#1d7a4d,color:#0d3b26,stroke-width:2px;
classDef err fill:#fbdcdc,stroke:#a4232b,color:#4a0f13,stroke-width:2px;
classDef ext fill:#dbe9fb,stroke:#1d4e89,color:#0b2545,stroke-width:2px;
classDef hot fill:#ffe9c7,stroke:#b7791f,color:#4a2f00,stroke-width:2px;
classDef human fill:#eef1f5,stroke:#4b5b6e,color:#1f2b38,stroke-width:2px;

class INTENT,L1,L2,L3,L4,L5 proc;
class ERR err;
class ADAPTER hot;
