flowchart TB
  REQ["a producer offers a payload"] --> A
  subgraph CHAIN["the chain, in this order, every time"]
    direction TB
    A{"<b>authority</b><br/>is this producer registered<br/>for this topic?"}
    A -->|no| X1["REFUSE<br/>unknown producer"]
    A -->|yes| B{"<b>schema</b><br/>does the payload decode<br/>into the expected shape?"}
    B -->|no| X2["REFUSE<br/>undecodable payload"]
    B -->|yes| C{"<b>keying</b><br/>is a keyed topic published<br/>with its key?"}
    C -->|no| X3["REFUSE<br/>missing key"]
    C -->|yes| D{"<b>correlation</b><br/>mint cid, chain parent"}
    D --> E{"<b>freshness</b><br/>age = now − computed_at<br/>within the topic TTL?"}
    E -->|no| X4["REFUSE<br/>stale: age, limit"]
    E -->|yes| F{"<b>budget</b><br/>is this operator within<br/>its cost or rate?"}
    F -->|no| X5["REFUSE<br/>over budget"]
    F -->|yes| GO["the operator runs"]
  end
  X1 --> ERR["system.error packet<br/>stage · rule · the number"]:::c_risk
  X2 --> ERR
  X3 --> ERR
  X4 --> ERR
  X5 --> ERR
  GO --> OP["the computed payload"]:::c_model
