flowchart TD
  A["alert resolves, or operator imports evidence"]
  O["onset timestamp fixed from journal"]
  W["training window: onset - 60m"]
  D["label envelope on intel.signal.outcome"]
  R["offline weight refit, precision-at-budget"]
  T["threshold update, versioned config"]
  A --> O --> W --> D --> R --> T
