flowchart TD
  SPEC["models.yaml<br/>single source of truth: family, params,<br/>anchor convention, formula ref"] --> GO["Go registry<br/>hand kernels, spec-conformance tests"]
  SPEC --> PY["Python agent kernels<br/>template-generated or ported"]
  SPEC --> JAX["jax GPU kernels<br/>vectorized mirrors"]
  GO --> PT["gate parity tests<br/>generated series x 5 shapes"]
  PY --> PT
  JAX --> PT
  PT -->|mismatch| FAIL["gate fails<br/>both outputs dumped"]
  PT -->|match| OK["displayed number =<br/>runnable model, everywhere"]

