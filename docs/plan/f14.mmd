flowchart TD
  BARS["bar stream per symbol+interval"]
  GEN["generation counter per topic+key<br/>monotonic, strictly ordered"]
  AGE["age = now - computed_at"]
  TTL["topic TTL: price 2s, forecast 60s,<br/>decision 5m, outcome 24h"]
  VERD{"age vs TTL"}
  OKY["allowed: operator runs"]
  REF["refused: system.error,<br/>numbers quoted"]
  BARS --> GEN --> AGE --> TTL --> VERD
  VERD -->|inside| OKY
  VERD -->|outside| REF
classDef proc fill:#d8eef2,stroke:#0f6b7a,color:#08343c,stroke-width:2px;
classDef data fill:#e9e3f7,stroke:#5b3fa8,color:#2a1a55,stroke-width:2px;
classDef decision fill:#ffe9c7,stroke:#b7791f,color:#4a2f00,stroke-width:2px;
classDef ok fill:#d9f2e3,stroke:#1d7a4d,color:#0d3b26,stroke-width:2px;
classDef err fill:#fbdcdc,stroke:#a4232b,color:#4a0f13,stroke-width:2px;
class BARS,TTL data;
class VERD decision;
class REF err;
class OKY ok;
class GEN,AGE proc;
