flowchart TD
  PLAT["platform: Go, the reference kernels"]
  AGTX["agent host: jobs over envelopes"]
  GPY["gpu runners: sweep, optimize, forecast, timestral"]
  CORPUS["generated corpus + golden files"]
  PAR["gate parity tests: go vs python vs jax"]
  PLAT <--> AGTX
  AGTX --> GPY
  CORPUS --> PAR
  PLAT --> PAR
  GPY --> PAR
  PAR -->|mismatch| STOPX["gate red, outputs dumped"]
  PAR -->|match| SHIP["numbers mean the same everywhere"]
classDef proc fill:#d8eef2,stroke:#0f6b7a,color:#08343c,stroke-width:2px;
classDef data fill:#e9e3f7,stroke:#5b3fa8,color:#2a1a55,stroke-width:2px;
classDef decision fill:#ffe9c7,stroke:#b7791f,color:#4a2f00,stroke-width:2px;
classDef ok fill:#d9f2e3,stroke:#1d7a4d,color:#0d3b26,stroke-width:2px;
classDef err fill:#fbdcdc,stroke:#a4232b,color:#4a0f13,stroke-width:2px;
classDef hot fill:#ffe9c7,stroke:#b7791f,color:#4a2f00,stroke-width:2px;
class CORPUS data;
class PAR decision;
class STOPX err;
class AGTX,GPY hot;
class SHIP ok;
class PLAT proc;
