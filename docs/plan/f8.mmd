flowchart TD
  subgraph chain["Every packet, in order"]
    direction TB
    A1["authority<br/>who may publish on this topic"] --> A2["keying<br/>symbol+interval identity"]
    A2 --> A3["correlation<br/>cid / parent_cid chain"]
    A3 --> A4["freshness<br/>age vs topic TTL"]
    A4 --> OK{"allowed?"}
    OK -->|yes| OP["operator<br/>the actual computation"]
    OK -->|no| ERR["system.error envelope<br/>stale forecast, age 1706s, limit 60s"]
    OP --> TX["transformer"]
    TX --> JR["append-only journal"]
  end
  JR --> RP["replay = backtest"]
  JR --> LN["lineage: why did we buy?"]

