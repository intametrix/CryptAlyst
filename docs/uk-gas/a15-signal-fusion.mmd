flowchart LR
    FND["fundamental<br/>(storage · balance)"] --> W2["weighted fusion"]
    ML2["ML<br/>(price · demand)"] --> W2
    SNT["sentiment<br/>(news · positioning)"] --> W2
    W2 --> P3["probability of direction"]
    P3 --> DEC["decision<br/>size · hedge"]
    class FND,ML2,SNT c_intel
    class W2 c_model
    class P3 c_intel
    class DEC c_model
