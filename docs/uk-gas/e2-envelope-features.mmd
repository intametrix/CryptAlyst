flowchart TD
    E["envelope"] --> M["meta<br/>producer · ts · generation · TTL"]
    E --> R["refs<br/>inputs + ages"]
    E --> C["cid<br/>correlation"]
    E --> H["hops<br/>pipeline stages"]
    M --> P["provenance<br/>who · when · order"]
    R --> L["lineage<br/>what it read"]
    C --> CH["chain<br/>tick → fill → pnl"]
    H --> G["gates<br/>authority · freshness"]
    class E c_neutral
    class M,R,C,H c_store
    class P,L,CH,G c_intel
