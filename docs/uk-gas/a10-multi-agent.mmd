flowchart LR
    A1["weather agent"] --> BUS["BUS"]
    A2["fundamental agent"] --> BUS
    A3["news agent"] --> BUS
    A4["sentiment agent"] --> BUS
    BUS --> A5["meta agent<br/>fuses signals → tier"]
    A5 --> TRD["trade / advise"]
    class A1,A2,A3,A4 c_intel
    class BUS c_neutral
    class A5 c_model
    class TRD c_model
