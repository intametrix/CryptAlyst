flowchart LR
    RAW["raw envelope"] --> NORM["normalise<br/>version · topic · key · ts"]
    NORM --> ENR["enrich<br/>HDD · balance · spark · sentiment"]
    ENR --> DER["derive<br/>features · aggregates · curve · basis"]
    DER --> STORE2["store (derived, versioned)"]
    class RAW c_market
    class NORM c_neutral
    class ENR,DER c_intel
    class STORE2 c_store
