flowchart TD
    P2["a packet"] --> PROV["knows its own provenance"]
    P2 --> LINE["knows its own lineage"]
    P2 --> CHAIN["knows its own chain"]
    PROV & LINE & CHAIN --> SD["the lake is self-documenting<br/>(a time machine)"]
    class P2 c_neutral
    class PROV,LINE,CHAIN c_intel
    class SD c_control
