flowchart LR
    subgraph BB["Bloomberg (terminal)"]
        B1["data + analytics<br/>read-only"]
        B2["black-box analytics<br/>not yours"]
        B3["no lineage · no replay"]
        B4["per-user · no record"]
    end
    subgraph AT["ATLAS + envelope (platform)"]
        A1["data + models + execution"]
        A2["your models · versioned"]
        A3["full lineage · replay"]
        A4["append-only lake · audit"]
    end
    class B1,B2,B3,B4 c_neutral
    class A1,A2,A3,A4 c_control
