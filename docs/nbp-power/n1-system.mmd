flowchart LR
    subgraph DATA["DATA"]
        ICE["ICE NBP gas<br/>TTF · curve"]
        PX["EPEX / EEX<br/>day-ahead · intraday power"]
        WX["weather<br/>HDD · wind · solar"]
        ST["storage · LNG · flows"]
    end
    subgraph CORE["ENVELOPE CORE (reused)"]
        BUS["BUS · envelopes"]
        MOD["models → signals"]
        BK["book · intel · strategy"]
        LAKE["lake"]
    end
    subgraph OUT["OUTPUT"]
        ADV["advisory<br/>bullish / bearish · spreads"]
        EXEC["auto / systematic<br/>orders"]
    end
    ICE & PX & WX & ST --> BUS
    BUS --> MOD
    MOD --> BUS
    BUS --> BK
    BK --> ADV & EXEC
    BUS --> LAKE
    class ICE,PX,WX,ST c_market
    class BUS c_neutral
    class MOD c_intel
    class BK c_model
    class LAKE c_store
    class ADV c_control
    class EXEC c_model
%% colour by role
classDef c_market  fill:#dbe9fb,stroke:#1d4e89,color:#0b2545,stroke-width:2px;
classDef c_intel   fill:#d9f2e3,stroke:#1d7a4d,color:#0d3b26,stroke-width:2px;
classDef c_model   fill:#ffe9c7,stroke:#b7791f,color:#4a2f00,stroke-width:2px;
classDef c_risk    fill:#fbdcdc,stroke:#a4232b,color:#4a0f13,stroke-width:2px;
classDef c_control fill:#d8eef2,stroke:#0f6b7a,color:#08343c,stroke-width:2px;
classDef c_store   fill:#e9e3f7,stroke:#5b3fa8,color:#2a1a55,stroke-width:2px;
classDef c_neutral fill:#eef1f5,stroke:#4b5b6e,color:#1f2b38,stroke-width:2px;
