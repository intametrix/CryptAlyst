flowchart LR
  subgraph One["one correlation id, end to end"]
    R1["request arrives<br/>cid minted"]
    R2["security gate<br/>step"]
    R3["ticker operator<br/>step"]
    R4["response<br/>refs and cid"]
  end
  R1 --> R2 --> R3 --> R4
  R4 --> Q["resolve: who asked,<br/>what was served,<br/>what was redacted"]

