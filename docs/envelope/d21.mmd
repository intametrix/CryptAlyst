flowchart LR
  T["ticks and candles"] --> A["advisory envelopes"]
  A --> D["decision envelopes"]
  D --> F["fill envelopes"]
  F --> L[("lake<br/>tiers plus retention")]
  D --> C["correlation map<br/>steps and refs"]
  F --> C
  C --> E["evidence pack<br/>one query"]
  L --> E
  E --> G{"gate<br/>auditor role"}
  G -->|permitted| R["report<br/>with read recorded"]
  G -->|refused| X["refusal step<br/>rule named"]

