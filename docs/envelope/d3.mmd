flowchart LR
  subgraph Plane["data plane — never blocked"]
    MD["market_data"]
    MDE["exchange: md.*"]
  end
  subgraph Compute["compute plane"]
    C1["flow calculator"]
    C2["volatility calculator"]
    C3["forecast blender"]
    AD["exchange: ind.*"]
  end
  subgraph Act["action plane"]
    E1["engines"]
    R1["risk"]
    CMD["exchange: cmd.*"]
  end
  subgraph Persist["persistence plane"]
    W["recorder"]
    S1[("hot store<br/>in-memory / KV")]
    S2[("cold store<br/>columnar / object")]
  end
  MD --> MDE --> C1 & C2 & C3
  C1 --> AD
  C2 --> AD
  C3 --> AD
  AD --> E1
  E1 --> R1
  R1 --> CMD
  MDE --> W
  AD --> W
  W --> S1
  W --> S2

%% colour by role
classDef c_market fill:#dbe9fb,stroke:#1d4e89,color:#0b2545,stroke-width:2px;
classDef c_intel fill:#d9f2e3,stroke:#1d7a4d,color:#0d3b26,stroke-width:2px;
classDef c_model fill:#ffe9c7,stroke:#b7791f,color:#4a2f00,stroke-width:2px;
classDef c_risk fill:#fbdcdc,stroke:#a4232b,color:#4a0f13,stroke-width:2px;
classDef c_store fill:#e9e3f7,stroke:#5b3fa8,color:#2a1a55,stroke-width:2px;
classDef c_control fill:#d8eef2,stroke:#0f6b7a,color:#08343c,stroke-width:2px;
classDef c_neutral fill:#eef1f5,stroke:#4b5b6e,color:#1f2b38,stroke-width:2px;
class MD c_neutral;
class MDE c_market;
class C1 c_intel;
class C2 c_intel;
class C3 c_intel;
class AD c_market;
class E1 c_model;
class R1 c_risk;
class CMD c_market;
class W c_model;
class S1 c_store;
class S2 c_store;