flowchart LR
  A["actor<br/>human · service · agent"] --> I["interceptor<br/>authenticate"]
  I --> G["authority gate<br/>role and scope"]
  G -->|refused| L["ledger<br/>refusal with rule"]
  G -->|permitted| O["operator<br/>the work"]
  O --> E["envelope<br/>result plus cid"]
  E --> R["redaction<br/>per role"]
  R --> C["caller"]
  O --> L2["ledger<br/>step appended"]

