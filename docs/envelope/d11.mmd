flowchart TB
  A["advisory arrives<br/>computed_at 09:12:44"]
  B{"age > limit"}
  B -->|yes| R["refuse<br/>reason quotes the envelope"]
  B -->|no| P["permit"]
  R --> L["decision envelope<br/>allowed = false"]
  P --> X["decision envelope<br/>allowed = true"]

