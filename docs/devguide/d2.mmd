flowchart LR
  R["HTTP request"] --> M["mux<br/>89 routes"]
  M --> Q["readQuery<br/>paramSymbol · paramInterval · paramInt"]
  Q --> P["pipeline.go<br/>interval policy · barsForRequest"]
  P --> S["bar store<br/>data/history/*.jsonl"]
  S -->|short| B["binance REST<br/>KlinesSource port"]
  P --> MD["model registry<br/>modelPath(method)"]
  MD --> E["envelope.Run<br/>authority · keying · correlation · freshness"]
  E --> OK["ok(w, payload)"]
  E --> RF["fail(w, msg)"]
  E --> J["journal + RabbitMQ"]
  class R,M,Q c_control;
  class P,MD c_model;
  class S,B c_market;
  class E,J c_store;
  class OK c_intel;
  class RF c_risk;
