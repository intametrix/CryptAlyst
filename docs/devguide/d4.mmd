flowchart LR
  subgraph VIEWS["App.tsx — six views, hash-routed"]
    v1["overview"]:::c_intel
    v2["pump & dump"]:::c_intel
    v3["message bus"]:::c_intel
    v4["settings"]:::c_intel
    v5["agents"]:::c_intel
    v6["forecast"]:::c_intel
  end
  subgraph SHARED["shared state, one owner each"]
    s1["selection.tsx<br/>symbol · interval"]:::c_control
    s2["glossaryContext.tsx<br/>tool tips"]:::c_control
    s3["usePersistentSize<br/>layout"]:::c_control
    s4["useNow<br/>one clock for the app"]:::c_control
  end
  subgraph DATA["data access"]
    d1["data/client.ts<br/>getJSON · postJSON · postAction"]:::c_model
    d2["useResource<T><br/>load · poll · abort · error"]:::c_model
    d3["usePoll<br/>one interval, latest closure"]:::c_model
  end
  subgraph COMP["components"]
    c1["panels<br/>alerts · leaderboard · split · screen"]:::c_neutral
    c2["charts<br/>ForecastChart · PriceChart"]:::c_neutral
    c3["sections<br/>parameter bar · picker · history"]:::c_neutral
  end
  VIEWS --> COMP
  COMP --> SHARED
  COMP --> DATA
  DATA --> API["/api/*"]:::c_store
