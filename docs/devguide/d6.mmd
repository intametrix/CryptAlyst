    m2["every class used exists and is styled"]:::c_intel
    m3["every panel renders from fixtures"]:::c_intel
    m4["the bundle boots and paints"]:::c_intel
  end
  WEBG --> MEAN
  GO --> m5["handlers answer with fakes"]:::c_intel
