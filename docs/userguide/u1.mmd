flowchart TB
  subgraph V["six views — the top bar"]
    v1["<b>OVERVIEW</b><br/>what is moving, right now"]:::c_intel
    v2["<b>PUMP &amp; DUMP</b><br/>the full fed screen"]:::c_intel
    v3["<b>MESSAGE BUS</b><br/>is the plumbing alive"]:::c_store
    v4["<b>SETTINGS</b><br/>what counts as a move"]:::c_control
    v5["<b>AGENTS</b><br/>the GPU workers"]:::c_model
    v6["<b>FORECAST</b><br/>train, compare, backtest"]:::c_model
  end
  v1 --> q1["should I look<br/>at this pair?"]
  v2 --> q1
  v3 --> q2["is data flowing?"]
  v4 --> q3["why did that<br/>alert fire?"]
  v5 --> q4["is the GPU<br/>box healthy?"]
  v6 --> q5["what does the model<br/>expect next?"]
