flowchart LR
  subgraph KEY["keyboard"]
    k1["↑ ↓<br/>leaderboard cursor"]:::c_control
    k2["Enter<br/>open the chart"]:::c_control
    k3["Esc<br/>close panel or drill-down"]:::c_control
  end
  subgraph MOUSE["mouse"]
    m1["wheel<br/>zoom the chart"]:::c_neutral
    m2["drag<br/>pan"]:::c_neutral
    m3["double-click<br/>fit the window"]:::c_neutral
    m4["hover a row<br/>freeze the order"]:::c_neutral
  end
  subgraph BUTTON["buttons"]
    b1["full / min<br/>expand a panel"]:::c_model
    b2["compact<br/>denser alert feed"]:::c_model
    b3["ALL / PERP / SPOT<br/>filter the board"]:::c_model
    b4["5s … all<br/>zoom presets"]:::c_model
  end
%% colour by role (docs/style-guide.md)
classDef c_market fill:#dbe9fb,stroke:#1d4e89,color:#0b2545,stroke-width:2px;
classDef c_intel fill:#d9f2e3,stroke:#1d7a4d,color:#0d3b26,stroke-width:2px;
classDef c_model fill:#ffe9c7,stroke:#b7791f,color:#4a2f00,stroke-width:2px;
classDef c_risk fill:#fbdcdc,stroke:#a4232b,color:#4a0f13,stroke-width:2px;
classDef c_control fill:#d8eef2,stroke:#0f6b7a,color:#08343c,stroke-width:2px;
classDef c_store fill:#e9e3f7,stroke:#5b3fa8,color:#2a1a55,stroke-width:2px;
classDef c_neutral fill:#eef1f5,stroke:#4b5b6e,color:#1f2b38,stroke-width:2px;
