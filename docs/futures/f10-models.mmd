flowchart TD
    M["model types"] --> PA["price action<br/>curve momentum · spread"]
    M --> SDM["supply/demand<br/>balance · storage"]
    M --> WM["weather<br/>HDD/CDD · wind · hydro"]
    M --> PM["politics<br/>sanctions · OPEC · export"]
    M --> GM["grid<br/>dispatch · congestion · storage"]
    PA & SDM & WM & PM & GM --> SIG["signal<br/>tier-ranked"]
    class M c_intel
    class PA,SDM,WM,PM,GM c_intel
    class SIG c_model
