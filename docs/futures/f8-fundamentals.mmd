flowchart TD
    F["fundamental models"] --> SD["supply / demand<br/>inventory · production · consumption"]
    F --> W["weather<br/>heating degree days · wind · hydro"]
    F --> P["politics / geopolitics<br/>sanctions · OPEC · export bans"]
    F --> G["grid level<br/>gas storage · electricity dispatch · congestion"]
    SD & W & P & G --> FC["fundamental forecast<br/>→ curve · basis"]
    class F c_intel
    class SD,W,P,G c_intel
    class FC c_model
