# Copy to `.env` and edit. Real environment variables always win over this file.
#
# NOTE: the scanner needs NO API key. All detection uses public market data
# (websocket ticker/aggTrade streams + public REST klines). Keys are only used
# by `python run.py --check-keys`, and this tool never places orders.

# --- credentials (optional) ------------------------------------------------
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- scope -----------------------------------------------------------------
# Spot only. FUTURES IS UNTUNED: "in the last 10 seconds suddenly a lot of
# volume is flowing" is a spot microstructure model; futures adds funding,
# liquidations and leverage artefacts that this detector does not model.
PUMPDUMP_MARKETS=spot
PUMPDUMP_QUOTE_ASSETS=USDT

# Only track pairs with at least this much 24h quote volume. Raised to 750k
# because thin books are where false positives live.
PUMPDUMP_MIN_QUOTE_VOLUME_24H=750000

# How many of the most liquid pairs to track (one websocket stream each).
PUMPDUMP_MAX_SYMBOLS_PER_MARKET=400

# How many top pairs to seed flow baselines for at startup from 1s klines.
# ~1000 one-second bars = ~16 minutes of history, so detection works at t0
# instead of after an 80-second warmup. 250 requests ~ 20-30s at startup.
PUMPDUMP_BOOTSTRAP_TOP_N=250
PUMPDUMP_BOOTSTRAP_KLINE_LIMIT=1000

# --- cadence ---------------------------------------------------------------
# Evaluation tick. The stream itself delivers ~1 message/second/symbol.
PUMPDUMP_SCAN_INTERVAL_SEC=1.0
# How often to refresh the universe / 24h volumes.
PUMPDUMP_CONTEXT_POLL_SEC=60
# Refresh flow baselines from 1s klines (0 disables).
PUMPDUMP_REBASELINE_EVERY_SEC=1800

# --- the core: onset detection --------------------------------------------
# The window over which "sudden volume" is measured. This is the design knob
# that most directly encodes "in the last N seconds a lot of volume flowed".
PUMPDUMP_FLOW_WINDOW_SEC=10

# Flow gates: volume in the window vs the symbol's OWN recent distribution.
# 8x its typical 10s flow AND 4 sigma. Raise for precision, lower for recall.
PUMPDUMP_MIN_BURST_MULTIPLE=8
PUMPDUMP_MIN_BURST_Z=4

# Absolute floor. Without this, a near-dead pair with a 0.0001 median flow
# produces a 5000x "burst" off a single $50 print.
PUMPDUMP_MIN_ABS_FLOW_USD=5000

# Price must actually be moving, fast, and in the same direction as the flow.
PUMPDUMP_MIN_MOVE_PCT_10S=0.4
# ...measured against the symbol's own short-horizon volatility.
PUMPDUMP_MIN_SIGMA_MULTIPLE=3

# Fraction of the window that must be covered by received ticks. Guards
# against scoring a "burst" built from 2 messages spanning 9 seconds.
PUMPDUMP_MIN_COVERAGE=0.7

# Lateness guards: reject the tail of a move that already happened.
PUMPDUMP_MAX_MOVE_PCT_60S=6
PUMPDUMP_MAX_24H_MOVE_PCT=60

# Require volume to still be building (current window > prior window).
PUMPDUMP_REQUIRE_ACCELERATION=true

# A burst made of three prints is not a pump.
PUMPDUMP_MIN_TRADES_10S=8

# --- thin-book artefact rejection ----------------------------------------
PUMPDUMP_MAX_SPREAD_PCT=0.004
PUMPDUMP_MIN_BOOK_DEPTH_USD=500

# --- trade-level confirmation --------------------------------------------
# Escalate a candidate to its @aggTrade stream to see whether the taker flow
# actually agrees with the direction of the move.
PUMPDUMP_CONFIRM_WITH_AGG_TRADES=true
PUMPDUMP_AGG_TRADE_TTL_SEC=180
PUMPDUMP_AGG_MAX_SYMBOLS=12
PUMPDUMP_AGG_MIN_IMBALANCE=0.55
# true = only alert when taker flow confirms. Higher precision, lower recall.
PUMPDUMP_AGG_EXCLUSIVE=false

# --- pump -> dump cycle tracking -----------------------------------------
# After a pump alert, watch for the give-back; this is what makes it a
# "pump and dump" rather than just a pump.
PUMPDUMP_REVERSAL_DROP_PCT=3
PUMPDUMP_WATCH_WINDOW_MIN=120

# Suppress repeat alerts for the same symbol+direction.
PUMPDUMP_COOLDOWN_SEC=900

# --- alerting -------------------------------------------------------------
PUMPDUMP_ALERT_JSONL=alerts.jsonl
PUMPDUMP_ALERT_CSV=alerts.csv
# Discord/Slack/Telegram/generic webhook. Empty = disabled.
PUMPDUMP_WEBHOOK_URL=
# For Telegram webhooks, the numeric chat id.
PUMPDUMP_TELEGRAM_CHAT_ID=
PUMPDUMP_DESKTOP_NOTIFY=false
# WATCH shows everything that passed the gates; ALERT/CRITICAL are quieter.
PUMPDUMP_MIN_SEVERITY=WATCH

# --- runtime --------------------------------------------------------------
PUMPDUMP_MAX_WORKERS=8
PUMPDUMP_LOG_LEVEL=INFO
