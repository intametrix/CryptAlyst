flowchart TD
    S["THE RULE<br/>inputs &rarr; (side, score)"] --> F{"forecast prob<br/>&ge; forecast_min (0.45)?"}
    F -->|"no"| RJ["REJECT"]
    F -->|"yes"| MV{"move_pct &ge;<br/>min_expected_move?"}
    MV -->|"no"| RJ
    MV -->|"yes"| TA["TA vote (intel.ta)<br/>fresh &le; 60s"]
    TA --> OI["OI quadrant multiplier<br/>(confirmation/divergence/climax)"]
    OI --> EG{"ext_gate +<br/>allow_counter_trend?"}
    EG -->|"no"| RJ
    EG -->|"yes"| RK{"risk.allow:<br/>size · exposure · staleness · shorts"}
    RK -->|"reject"| RJ
    RK -->|"pass"| ENTRY["OPEN POSITION<br/>sized by risk_for + size_mult"]
    RJ --> S
%% colour by role
classDef c_market  fill:#dbe9fb,stroke:#1d4e89,color:#0b2545,stroke-width:2px;
classDef c_intel   fill:#d9f2e3,stroke:#1d7a4d,color:#0d3b26,stroke-width:2px;
classDef c_model   fill:#ffe9c7,stroke:#b7791f,color:#4a2f00,stroke-width:2px;
classDef c_risk    fill:#fbdcdc,stroke:#a4232b,color:#4a0f13,stroke-width:2px;
classDef c_control fill:#d8eef2,stroke:#0f6b7a,color:#08343c,stroke-width:2px;
classDef c_store   fill:#e9e3f7,stroke:#5b3fa8,color:#2a1a55,stroke-width:2px;
classDef c_neutral fill:#eef1f5,stroke:#4b5b6e,color:#1f2b38,stroke-width:2px;
class S c_model;
class F,MV,TA,OI c_intel;
class EG,RK,RJ c_risk;
class ENTRY c_model;
