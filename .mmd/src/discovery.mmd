flowchart LR
    REG["TOPIC REGISTRY<br/>topics.go (Go) + bus.py (Python)<br/>22 topics · exchange · allowed producers"] --> D{"engine asks:<br/>which topics do I need?"}
    D -->|"declared in code"| SUB["subscribe(queue)<br/>or read via HTTP proxy"]
    SUB --> CHK{"topic registered<br/>AND producer allowed?"}
    CHK -->|"yes"| OK["receive envelopes<br/>route by meta.key"]
    CHK -->|"no"| REF["REFUSED — dropped<br/>(guard before publish)"]
